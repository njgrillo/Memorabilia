<DivPad2>
    <Stack Style="@Style.MarginBottomPad1">
        <DivRowCol12>
            <CondensedPersonSelector SelectedPerson="SelectedPerson"
                                     SelectedPersonChanged="(p) => OnSelectedPersonChanged(p.Id)" />
        </DivRowCol12>        
        <Condition Evaluation="PersonIsSelected">
            <Match>
                <DivRow>
                    <Div Class="@DivClass.Column6">
                        <TextField Label="Nickname"
                                   MaxLength="100"
                                   SelectedText="@NicknameEditModel.Nickname"
                                   SelectedTextChanged="@((p) => NicknameEditModel.Nickname = p)" />
                    </Div>
                    <Div Class="@DivClass.Column2">
                        <AddUpdateFab EditMode="EditMode"
                                      OnAdd="Add"
                                      OnUpdate="Update" />
                    </Div>
                </DivRow>  
            </Match>
        </Condition>        
    </Stack>
    <Condition Evaluation="PersonIsSelected">
        <Match>
            <DivRowCol12 Style="@Style.MarginBottomPad1">
                <MudTable Bordered="false"
                          Dense="false"
                          Hover="true"
                          Items="_nicknames"
                          Striped="true">
                    <HeaderContent>
                        <SortedColumn SortBy="new Func<NicknameEditModel, object>(x => x.Nickname)" Title="Nickname" />
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nickname">@context.Nickname</MudTd>
                        <TableDataRightAligned>
                            <EditGridButton OnEdit="@(_ => Edit(context))" />
                            <DeleteGridButton OnDelete="@(_ => context.Delete())" />
                        </TableDataRightAligned>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </DivRowCol12>
            <LeftRightSection>
                <Right>
                    <RowStack Style="@($"{Style.MarginBottomPad1}{Style.MarginTopPad1}")">
                        <SaveButton OnClick="OnSave"
                                    Text="Save" />
                    </RowStack>
                </Right>
            </LeftRightSection>
        </Match>
    </Condition>  
    <PageFooter NavigationPath="/Admin/People/Management/ManagePersonItemsPage"
                NavigationPathText="Back"
                Visible="true" />
</DivPad2>
