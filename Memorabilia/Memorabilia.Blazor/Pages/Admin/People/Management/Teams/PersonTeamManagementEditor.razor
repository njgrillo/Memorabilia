<DivPad2>
    <Div Class="@DivClass.Column6"
         Style="@Style.MarginBottomPad1">
        <CondensedPersonSelector SelectedPerson="SelectedPerson"
                                 SelectedPersonChanged="(p) => OnSelectedPersonChanged(p.Id)" />
    </Div>    
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">        
        <Condition Evaluation="@(SelectedPerson.Id > 0)">
            <Match>
                <NullableIntField Label="Begin Year"
                                  Value="PersonTeamManagementEditModel.Team.BeginYear"
                                  ValueChanged="@((p) => PersonTeamManagementEditModel.Team.BeginYear = p)" />
                <NullableIntField Label="End Year"
                                  Value="PersonTeamManagementEditModel.Team.EndYear"
                                  ValueChanged="@((p) => PersonTeamManagementEditModel.Team.EndYear = p)" />
                <Div Class="@DivClass.Column3">
                    <TeamRoleTypeAutoComplete SelectedValue="PersonTeamManagementEditModel.Team.TeamRoleType"
                                              SelectionChanged="(p) => PersonTeamManagementEditModel.Team.TeamRoleType = p"
                                              SportLeagueLevel="PersonTeamManagementEditModel.Team.SportLeagueLevel" />
                </Div>
                <Div Class="@DivClass.Column6">
                    <Condition Evaluation="@(!_teamIsReadOnly)">
                        <Match>
                            <PersonTeamAutoComplete BeginYear="PersonTeamManagementEditModel.Team.BeginYear"
                                                    Disabled="@(EditMode == EditModeType.Update)"
                                                    EndYear="PersonTeamManagementEditModel.Team.EndYear"
                                                    PersonId="@SelectedPerson.Id"
                                                    ResetValueOnEmptyText="true"
                                                    SelectedValue="PersonTeamManagementEditModel.Team"
                                                    SelectionChanged="(p) => PersonTeamManagementEditModel.Team = p"
                                                    SportIds="@SelectedPerson.Sports.Select(x => x.Id).ToArray()" />
                        </Match>
                        <NotMatch>
                            <Text Typography="Typo.caption">
                                @PersonTeamManagementEditModel.Team.TeamDisplayName
                            </Text>
                        </NotMatch>
                    </Condition>                    
                </Div>
                <AddUpdateFab EditMode="EditMode"
                              OnAdd="Add"
                              OnUpdate="Update" />
            </Match>
        </Condition>
    </RowStack>
    <Condition Evaluation="@(SelectedPerson.Id > 0)">
        <Match>
            <DivRowCol12 Style="@Style.MarginBottomPad1">
                <MudTable Bordered="false"
                          Dense="false"
                          Filter="new Func<PersonTeamManagementEditModel,bool>(x => x.Search(_search))"
                          Hover="true"
                          Items="_personTeamManagements"
                          Striped="true">
                    <ToolBarContent>
                        <ToolbarTitle Text="Teams" />
                        <MudSpacer />
                        <ToolbarSearchField SearchText="@_search"
                                            SearchTextChanged="@((p) => _search = p)" />
                    </ToolBarContent>
                    <HeaderContent>
                        <SortedColumn SortBy="new Func<PersonTeamManagementEditModel, object>(x => x.Team.FranchiseName)" Title="Franchise" />
                        <SortedColumn SortBy="new Func<PersonTeamManagementEditModel, object>(x => x.Team.TeamLocation)" Title="Location" />
                        <SortedColumn SortBy="new Func<PersonTeamManagementEditModel, object>(x => x.Team.TeamName)" Title="Team" />
                        <SortedColumn SortBy="new Func<PersonTeamManagementEditModel, object>(x => x.Team.BeginYear)" Title="Begin Year" />
                        <SortedColumn SortBy="new Func<PersonTeamManagementEditModel, object>(x => x.Team.EndYear)" Title="End Year" />
                        <SortedColumn SortBy="new Func<PersonTeamManagementEditModel, object>(x => x.Team.TeamRoleTypeName)" Title="Role" />
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Franchise">@context.Team.FranchiseName</MudTd>
                        <MudTd DataLabel="Location">@context.Team.TeamLocation</MudTd>
                        <MudTd DataLabel="Team">@context.Team.TeamName</MudTd>
                        <MudTd DataLabel="Begin Year">@context.Team.BeginYear</MudTd>
                        <MudTd DataLabel="End Year">@context.Team.EndYear</MudTd>
                        <MudTd DataLabel="Role">@context.Team.TeamRoleTypeName</MudTd>
                        <TableDataRightAligned>
                            <EditGridButton OnEdit="@(_ => Edit(context))" />
                            <DeleteGridButton OnDelete="@(_ => context.IsDeleted = true)" />
                        </TableDataRightAligned>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </DivRowCol12>            
            <LeftRightSection>
                <Right>
                    <RowStack Style="@($"{Style.MarginBottomPad1}{Style.MarginTopPad1}")">
                        <SaveButton OnClick="OnSave"
                                    Text="Save" />
                    </RowStack>
                </Right>
            </LeftRightSection>
        </Match>
    </Condition>
    <PageFooter NavigationPath="/Admin/People/Management/ManagePersonItemsPage"
                NavigationPathText="Back"
                Visible="true" />
</DivPad2>
