<DivPad2>
    <RowStack>
        <Div Class="@DivClass.Column3"
             Style="@Style.MarginBottomPad1">
            <CollegeAutoComplete ResetValueOnEmptyText="false"
                                 SelectedValue="EditModel.College"
                                 SelectionChanged="(p) => OnCollegeChanged(p)" />
        </Div>
    </RowStack>
    <RowStack>
        <Condition Evaluation="@(EditModel.CollegeId > 0)">
            <Match>
                <Div Class="@DivClass.Column3">
                    <CondensedPersonSelector People="People"
                                             SelectedPerson="@HallOfFameEditModel.Person"
                                             SelectedPersonChanged="(p) => HallOfFameEditModel.Person = p"
                                             UseProvidedPeople="true" />
                </Div>
                <Div Class="@DivClass.Column2">
                    <NullableIntField Label="Induction Year"
                                      Value="HallOfFameEditModel.Year"
                                      ValueChanged="@((p) => HallOfFameEditModel.Year = p)" />
                </Div>
                <Div Class="@DivClass.Column2">
                    <SportAutoComplete SelectedValue="HallOfFameEditModel.Sport"
                                       SelectionChanged="(p) => HallOfFameEditModel.Sport = p" />
                </Div>                
                <Div Class="@DivClass.Column2">
                    <AddUpdateFab EditMode="EditMode"
                                  OnAdd="Add"
                                  OnUpdate="Update" />
                </Div>
            </Match>
        </Condition>
    </RowStack>
    <Condition Evaluation="@(EditModel.CollegeId > 0)">
        <Match>
            <Div Class="@DivClass.Row"
                 Style="@Style.MarginTopPad1">
                <Div Class="@DivClass.Column12">
                    <MudTable Bordered="false"
                              Dense="false"
                              Filter="new Func<CollegeHallOfFameEditModel,bool>(x => x.Search(_search))"
                              Hover="true"
                              Items="EditModel.HallOfFames.Where(hof => !hof.IsDeleted).OrderBy(hof => hof.Year).ThenBy(hof => hof.Person.ProfileName).ToList()"
                              Striped="true">
                        <ToolBarContent>
                            <ToolbarTitle Text="@($"{EditModel.CollegeName} Hall of Fame")" />
                            <MudSpacer />
                            <ToolbarSearchField SearchText="@_search"
                                                SearchTextChanged="@((p) => _search = p)" />
                        </ToolBarContent>
                        <HeaderContent>
                            <BlankColumn />
                            <SortedColumn SortBy="new Func<CollegeHallOfFameEditModel, object>(x => x.Person?.ProfileName)" Title="Person" />
                            <SortedColumn SortBy="new Func<CollegeHallOfFameEditModel, object>(x => x.Year)" Title="Induction Year" />
                            <SortedColumn SortBy="new Func<CollegeHallOfFameEditModel, object>(x => x.SportName)" Title="Sport" />
                            <BlankColumn />
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <PersonGridImage ImageData="@(ImageService.GetPersonImageData(context.Person.ImageFileName))"
                                                 ImageLoaded="StateHasChanged"
                                                 PersonId="context.Person.Id" />
                            </MudTd>
                            <MudTd DataLabel="Person">@context.Person?.ProfileName</MudTd>
                            <MudTd DataLabel="Induction Year">@context.Year</MudTd>
                            <MudTd DataLabel="Sport">@context.SportName</MudTd>
                            <TableDataRightAligned>
                                <EditGridButton OnEdit="@(_ => Edit(context))" />
                                <DeleteGridButton OnDelete="@(_ => context.IsDeleted = true)" />
                            </TableDataRightAligned>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </Div>
            </Div>
        </Match>
    </Condition>
    <LeftRightSection Style="@($"{Style.MarginBottomPad1}{Style.MarginTopPad1}")">
        <Right>
            <Condition Evaluation="@(EditModel.CollegeId > 0)">
                <Match>
                    <SaveButton OnClick="OnSave"
                                Text="Save" />
                </Match>
            </Condition>
        </Right>
    </LeftRightSection>
    <PageFooter NavigationPath="/Admin/People/Management/ManagePersonItemsPage"
                NavigationPathText="Back"
                Visible="true" />
</DivPad2>