@inherits ViewItem<CommissionersModel, CommissionerModel>

<PageView AddRoute="@Model.AddRoute" 
          AddTitle="@Model.AddTitle"
          DisplayPageHeader="false"
          NavigationPath="@Model.ExitNavigationPath"
          PageTitle="@Model.PageTitle">
    <DivPad2>
        <MudTable Bordered="false"
                  Dense="false"
                  Filter="new Func<CommissionerModel, bool>(FilterFunc1)"
                  Hover="true"
                  Items="Model.Commissioners"
                  Striped="true"
                  Virtualize="true">
            <NoRecordsContent>
                <NoRecords Text="No records found" />
            </NoRecordsContent>
            <ToolBarContent>
                <ToolbarTitle Text="@Model.PageTitle" />
                <MudSpacer />
                <ToolbarSearchField SearchText="@Search"
                                    SearchTextChanged="@((p) => Search = p)" />
            </ToolBarContent>
            <HeaderContent>
                <SortedColumn SortBy="new Func<CommissionerModel, object>(x => x.SportLeagueLevelName)" Title="Sport League" />
                <SortedColumn SortBy="new Func<CommissionerModel, object>(x => x.Person.DisplayName)" Title="Name" />
                <SortedColumn SortBy="new Func<CommissionerModel, object>(x => x.BeginYear)" Title="Begin Year" />
                <SortedColumn SortBy="new Func<CommissionerModel, object>(x => x.EndYear)" Title="End Year" />
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>                
                <MudTd DataLabel="Sport League">@context.SportLeagueLevelName</MudTd>
                <MudTd DataLabel="Name">@context.Person.DisplayName</MudTd>
                <MudTd DataLabel="Begin Year">@context.BeginYear</MudTd>
                <MudTd DataLabel="End Year">@context.EndYear</MudTd>
                <MudTd>
                    <NavigationGridButton NavigationPath="@($"{Model.RoutePrefix}/{EditModeType.Update.Name}/{context.Id}")" />
                    <DeleteGridButton ConfirmMessage="Delete Commissioner"
                                      OnDelete="@(_ => Delete(context.Id))"
                                      ShowConfirm="true" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DivPad2>
</PageView>