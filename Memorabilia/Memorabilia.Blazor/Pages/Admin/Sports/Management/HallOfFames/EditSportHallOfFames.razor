<DivPad2>
    <RowStack>
        <Div Class="@DivClass.Column3"
             Style="@Style.MarginBottomPad1">
            <SportLeagueLevelDropDown IsHallOfFameOnly="true" 
                                      SelectedValue="EditModel.SportLeagueLevelId"
                                      SelectionChanged="(p) => OnSportLeagueLevelChanged(p)" />
        </Div>
    </RowStack>    
    <RowStack>
        <Condition Evaluation="@(EditModel.SportLeagueLevelId > 0)">
            <Match>
                <Div Class="@DivClass.Column3">
                    <CondensedPersonSelector People="People"
                                             SelectedPerson="@HallOfFameEditModel.Person"
                                             SelectedPersonChanged="(p) => HallOfFameEditModel.Person = p"
                                             UseProvidedPeople="true" />
                </Div>
                <Div Class="@DivClass.Column2">
                    <NullableIntField Label="Induction Year"
                                      Value="HallOfFameEditModel.InductionYear"
                                      ValueChanged="@((p) => HallOfFameEditModel.InductionYear = p)" />
                </Div>
                <Div Class="@DivClass.Column2">
                    <BallotNumberDropDown SelectedValue="HallOfFameEditModel.BallotNumber"
                                          SelectionChanged="(p) => HallOfFameEditModel.BallotNumber = p" />
                </Div>
                <Div Class="@DivClass.Column2">
                    <NullableDecimalField Label="Vote Percentage"
                                          Maximum="100"
                                          Value="HallOfFameEditModel.VotePercentage"
                                          ValueChanged="@((p) => HallOfFameEditModel.VotePercentage = p)" />
                </Div>
                <Div Class="@DivClass.Column2">
                    <AddUpdateFab EditMode="EditMode"
                                  OnAdd="Add"
                                  OnUpdate="Update" />
                </Div> 
            </Match>
        </Condition>
    </RowStack>  
    <Condition Evaluation="@(EditModel.SportLeagueLevelId > 0)">
        <Match>
            <Div Class="@DivClass.Row"
                 Style="@Style.MarginTopPad1">
                <Div Class="@DivClass.Column12">
                    <MudTable Bordered="false"
                              Dense="false"
                              Filter="new Func<SportHallOfFameEditModel,bool>(x => x.Search(_search))"
                              Hover="true"
                              Items="EditModel.HallOfFames.Where(hof => !hof.IsDeleted).OrderBy(hof => hof.InductionYear).ThenBy(hof => hof.Person.ProfileName).ToList()"
                              Striped="true">
                        <ToolBarContent>
                            <ToolbarTitle Text="@($"{EditModel.SportName} Hall of Fame")" />
                            <MudSpacer />
                            <ToolbarSearchField SearchText="@_search"
                                                SearchTextChanged="@((p) => _search = p)" />
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh></MudTh>
                            <SortedColumn SortBy="new Func<SportHallOfFameEditModel, object>(x => x.Person?.ProfileName)" Title="Person" />
                            <SortedColumn SortBy="new Func<SportHallOfFameEditModel, object>(x => x.InductionYear)" Title="Induction Year" />
                            <SortedColumn SortBy="new Func<SportHallOfFameEditModel, object>(x => x.VotePercentage)" Title="Vote Percentage" />
                            <SortedColumn SortBy="new Func<SportHallOfFameEditModel, object>(x => x.BallotNumberName)" Title="Ballot" />
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <PersonGridImage ImageData="@(ImageService.GetPersonImageData(context.Person.ImageFileName))"
                                                 ImageLoaded="StateHasChanged"
                                                 PersonId="context.Person.Id" />
                            </MudTd>
                            <MudTd DataLabel="Person">@context.Person?.ProfileName</MudTd>
                            <MudTd DataLabel="Induction Year">@context.InductionYear</MudTd>
                            <MudTd DataLabel="Vote Percentage">@context.VotePercentage</MudTd>
                            <MudTd DataLabel="Ballot">@context.BallotNumberName</MudTd>
                            <TableDataRightAligned>
                                <EditGridButton OnEdit="@(_ => Edit(context))" />
                                <DeleteGridButton OnDelete="@(_ => context.IsDeleted = true)" />
                            </TableDataRightAligned>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </Div>
            </Div>
        </Match>
    </Condition>
    <LeftRightSection Style="@($"{Style.MarginBottomPad1}{Style.MarginTopPad1}")">
        <Right>
            <Condition Evaluation="@(EditModel.SportLeagueLevelId > 0)">
                <Match>
                    <SaveButton OnClick="OnSave"
                                Text="Save" />
                </Match>
            </Condition>            
        </Right>
    </LeftRightSection>
    <PageFooter NavigationPath="/Admin/Sports/Management/ManageSportItemsPage"
                NavigationPathText="Back"
                Visible="true" />
</DivPad2>