@inherits ViewItem<PewtersModel, PewterModel>

<PageView AddRoute="@Model.AddRoute" 
          AddTitle="@Model.AddTitle"
          DisplayPageHeader="false"
          NavigationPath="@Model.ExitNavigationPath"
          PageTitle="@Model.PageTitle">
    <DivPad2>
        <MudTable Bordered="false"
                  Dense="false"
                  Filter="new Func<PewterModel, bool>(FilterFunc1)"
                  Hover="true"
                  Items="Model.Pewters"
                  Striped="true"
                  Virtualize="true">
            <NoRecordsContent>
                <NoRecords Text="No records found" />
            </NoRecordsContent>
            <ToolBarContent>
                <ToolbarTitle Text="@Model.PageTitle" />
                <MudSpacer />
                <ToolbarSearchField SearchText="@Search"
                                    SearchTextChanged="@((p) => Search = p)" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh></MudTh>
                <SortedColumn SortBy="new Func<PewterModel, object>(x => x.FranchiseName)" Title="Franchise" />
                <SortedColumn SortBy="new Func<PewterModel, object>(x => x.TeamName)" Title="Team" />
                <SortedColumn SortBy="new Func<PewterModel, object>(x => x.SizeName)" Title="Size" />
                <SortedColumn SortBy="new Func<PewterModel, object>(x => x.ImageTypeName)" Title="Image Type" />
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <GridImage AllowNavigation="false" 
                               Height="150" 
                               ImageData="@(ImageService.GetPewterImageData(context.ImageFileName))"
                               ImageLoaded="StateHasChanged"
                               Width="150" />
                </MudTd>
                <MudTd DataLabel="Franchise">@context.FranchiseName</MudTd>
                <MudTd DataLabel="Team">@context.TeamName</MudTd>
                <MudTd DataLabel="Size">@context.SizeName</MudTd>
                <MudTd DataLabel="Image Type">@context.ImageTypeName</MudTd>
                <MudTd>
                    <NavigationGridButton NavigationPath="@($"{Model.RoutePrefix}/{EditModeType.Update.Name}/{context.Id}")" />
                    <DeleteGridButton ConfirmMessage="Delete Pewter"
                                      OnDelete="@(_ => Delete(context.Id))"
                                      ShowConfirm="true" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DivPad2>
</PageView>