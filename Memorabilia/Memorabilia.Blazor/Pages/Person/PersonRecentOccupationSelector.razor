<MudTable Bordered="false"
          Dense="false"
          Hover="true"
          Items="RecentOccupations"
          RowsPerPage="5"
          Striped="true">
    <ToolBarContent>
        <ToolbarTitle Text="Use Recent Template" />
    </ToolBarContent>
    <HeaderContent>        
        <MudTh>Occupations</MudTh>
        <MudTh>Positions</MudTh>
        <MudTh>Sports</MudTh>     
        <BlankColumn />
    </HeaderContent>
    <RowTemplate>    
        <SortedColumn SortBy="new Func<RecentPersonOccupationsModel, object>(x => x.OccupationsDisplayText)" Title="Occupations" />
        <SortedColumn SortBy="new Func<RecentPersonOccupationsModel, object>(x => x.PositionsDisplayText)" Title="Positions" />
        <SortedColumn SortBy="new Func<RecentPersonOccupationsModel, object>(x => x.SportsDisplayText)" Title="Sports" />
        <TableDataRightAligned>
            <Fab Color="MudBlazor.Color.Primary"
                 OnClick="@(_ => Select(context))"
                 StartIcon="@Icons.Material.Outlined.AddCircleOutline"
                 TooltipText="Select" />
        </TableDataRightAligned>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
