<DivRowFormGroup>
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <SportLeagueLevelDropDown Disabled="@(EditMode == EditModeType.Update)"
                                  SelectedValue="Model.SportLeagueLevelId"
                                  SelectionChanged="(p) => Model.SportLeagueLevelId = p" />
        <BallotNumberDropDown SelectedValue="Model.BallotNumber"
                              SelectionChanged="(p) => Model.BallotNumber = p" />
        <NullableIntField Label="Induction Year"
                          Value="Model.InductionYear"
                          ValueChanged="@((p) => Model.InductionYear = p)" />
        <NullableDecimalField Label="Vote Percentage"
                              Maximum="100"
                              Value="Model.VotePercentage"
                              ValueChanged="@((p) => Model.VotePercentage = p)" />
        <AddUpdateFab EditMode="EditMode"
                      OnAdd="Add"
                      OnUpdate="Update" />
    </RowStack>
</DivRowFormGroup>
<Div Class="@DivClass.Row">
    <Div Class="@DivClass.Column12">
         <MudTable Bordered="false"
                   Dense="false" 
                   Hover="true"
                   Items="HallOfFames.ActiveItems().ToList()"    
                   Striped="true"
                   Virtualize="true">
            <NoRecordsContent>
                <NoRecords Text="No records found" />
            </NoRecordsContent>
            <HeaderContent>
                <SortedColumn SortBy="new Func<PersonHallOfFameEditModel, object>(x => x.SportName)" Title="Sport" />
                <SortedColumn SortBy="new Func<PersonHallOfFameEditModel, object>(x => x.InductionYear)" Title="Induction Year" />
                <SortedColumn SortBy="new Func<PersonHallOfFameEditModel, object>(x => x.VotePercentage)" Title="Vote Percentage" />
                <SortedColumn SortBy="new Func<PersonHallOfFameEditModel, object>(x => x.BallotNumberName)" Title="Ballot" />
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Sport">@context.SportName</MudTd>
                <MudTd DataLabel="Induction Year">@context.InductionYear</MudTd>
                <MudTd DataLabel="Vote Percentage">@context.VotePercentage</MudTd>
                <MudTd DataLabel="Ballot">@context.BallotNumberName</MudTd>
                <TableDataRightAligned>
                    <EditGridButton OnEdit="@(_ => Edit(context))" />
                    <DeleteGridButton OnDelete="@(_ => context.Delete())" />
                </TableDataRightAligned>
            </RowTemplate>
        </MudTable>
    </Div>
</Div>

