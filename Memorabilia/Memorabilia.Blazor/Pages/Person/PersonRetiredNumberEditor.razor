<DivRowFormGroup>
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <FranchiseAutoComplete Disabled="@(EditMode == EditModeType.Update)"
                               SelectedValue="Model.Franchise"
                               SelectionChanged="(p) => Model.Franchise = p"
                               Sports="Sports" />
        <TextField Label="Number" 
                   MaxLength="3"
                   SelectedText="@Model.PlayerNumber"
                   SelectedTextChanged="@((p) => Model.PlayerNumber = p)" />
        <AddUpdateFab EditMode="EditMode"
                      OnAdd="Add"
                      OnUpdate="Update" />
    </RowStack>
</DivRowFormGroup>
<Div Class="@DivClass.Row">
    <Div Class="@DivClass.Column12">
         <MudTable Bordered="false"
                   Dense="false" 
                   Hover="true"
                   Items="RetiredNumbers.ActiveItems().ToList()"    
                   Striped="true"
                   Virtualize="true">
            <NoRecordsContent>
                <NoRecords Text="No records found" />
            </NoRecordsContent>
            <HeaderContent>
                <SortedColumn SortBy="new Func<PersonRetiredNumberEditModel, object>(x => x.FranchiseName)" Title="Franchise" />
                <SortedColumn SortBy="new Func<PersonRetiredNumberEditModel, object>(x => x.PlayerNumber)" Title="Number" />
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Franchise">@context.FranchiseName</MudTd>
                <MudTd DataLabel="Number">@context.PlayerNumber</MudTd>
                <TableDataRightAligned>
                    <EditGridButton OnEdit="@(_ => Edit(context))" />
                    <DeleteGridButton OnDelete="@(_ => context.Delete())" />
                </TableDataRightAligned>
            </RowTemplate>
        </MudTable>
    </Div>
</Div>

