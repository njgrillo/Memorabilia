<DivRowFormGroup>    
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <Div Class="@DivClass.Column6">
            <CollegeAutoComplete Disabled="@(EditMode == EditModeType.Update)"
                                 ResetValueOnEmptyText="false"
                                 SelectedValue="Model.College"
                                 SelectionChanged="(p) => Model.College = p" />
        </Div>
        <NullableIntField Label="Begin Year"
                          Value="Model.BeginYear"
                          ValueChanged="@((p) => Model.BeginYear = p)" />
        <NullableIntField Label="End Year"
                          Value="Model.EndYear"
                          ValueChanged="@((p) => Model.EndYear = p)" />
        <AddUpdateFab EditMode="EditMode"
                      OnAdd="Add"
                      OnUpdate="Update" />
    </RowStack>
</DivRowFormGroup>
<DivRowCol12>
    <MudTable Bordered="false"
              Dense="false"
              Hover="true"
              Items="Colleges.ActiveItems().ToList()"
              Striped="true"
              Virtualize="true">
        <NoRecordsContent>
            <NoRecords Text="No records found" />
        </NoRecordsContent>
        <HeaderContent>
            <SortedColumn SortBy="new Func<PersonCollegeEditModel, object>(x => x.CollegeName)" Title="College" />
            <SortedColumn SortBy="new Func<PersonCollegeEditModel, object>(x => x.BeginYear)" Title="Begin Year" />
            <SortedColumn SortBy="new Func<PersonCollegeEditModel, object>(x => x.EndYear)" Title="End Year" />
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="College">@context.CollegeName</MudTd>
            <MudTd DataLabel="Begin Year">@context.BeginYear</MudTd>
            <MudTd DataLabel="End Year">@context.EndYear</MudTd>
            <TableDataRightAligned>
                <EditGridButton OnEdit="@(_ => Edit(context))" />
                <DeleteGridButton OnDelete="@(_ => context.Delete())" />
            </TableDataRightAligned>
        </RowTemplate>
    </MudTable>
</DivRowCol12>



