<DivRowFormGroup>
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <LeaderTypeAutoComplete ResetValueOnEmptyText="false"
                                SelectedValue="Model.LeaderType"
                                SelectionChanged="(p) => Model.LeaderType = p"
                                Sports="Sports" />
        <TextField HelperText="Ex. 1999 or 1999-2002 or 2003, 2005-2008"
                   Label="Years"
                   SelectedText="@_years"
                   SelectedTextChanged="@((p) => _years = p)" />
        <AddFab OnAdd="Add" />
    </RowStack>
</DivRowFormGroup>
<Div Class="@DivClass.Row">
    <Div Class="@DivClass.Column12">
         <MudTable Bordered="false"
                   Dense="false"
                   Filter="new Func<PersonLeaderEditModel, bool>(Filter)"
                   Hover="true"
                   Items="Leaders.ActiveItems().ToList()"    
                   Striped="true"
                   Virtualize="true">
            <NoRecordsContent>
                <NoRecords Text="No records found" />
            </NoRecordsContent>
            <ToolBarContent>
                <ToolbarTitle Text="Leaders" />
                <MudSpacer />
                <ToolbarSearchField SearchText="@_search"
                                    SearchTextChanged="@((p) => _search = p)" />
            </ToolBarContent>
            <HeaderContent>
                <SortedColumn SortBy="new Func<PersonLeaderEditModel, object>(x => x.LeaderTypeName)" Title="Leader" />
                <SortedColumn SortBy="new Func<PersonLeaderEditModel, object>(x => x.Year)" Title="Year" />
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Leader">@context.LeaderTypeName</MudTd>
                <MudTd DataLabel="Year">@context.Year</MudTd>
                <TableDataRightAligned>
                    <DeleteGridButton OnDelete="@(_ => context.Delete())" />
                </TableDataRightAligned>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </Div>
</Div>

