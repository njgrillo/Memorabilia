<DivRowFormGroup>
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <InternationalHallOfFameTypeDropDown Disabled="@(EditMode == EditModeType.Update)"
                                             Label="Type"
                                             SelectedValue="Model.InternationalHallOfFameTypeId"
                                             SelectionChanged="(p) => Model.InternationalHallOfFameTypeId = p" />
        <NullableIntField Label="Induction Year"
                          Value="Model.Year"
                          ValueChanged="@((p) => Model.Year = p)" />
        <AddUpdateFab EditMode="EditMode"
                      OnAdd="Add"
                      OnUpdate="Update" />
    </RowStack>
</DivRowFormGroup>
<DivRowCol12>
    <MudTable Bordered="false"
              Dense="false"
              Hover="true"
              Items="InternationalHallOfFames.ActiveItems().ToList()"
              Striped="true"
              Virtualize="true">
        <NoRecordsContent>
            <NoRecords Text="No records found" />
        </NoRecordsContent>
        <HeaderContent>
            <SortedColumn SortBy="new Func<PersonInternationalHallOfFameEditModel, object>(x => x.InternationalHallOfFameTypeName)" Title="Type" />
            <SortedColumn SortBy="new Func<PersonInternationalHallOfFameEditModel, object>(x => x.Year)" Title="Induction Year" />
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Type">@context.InternationalHallOfFameTypeName</MudTd>
            <MudTd DataLabel="Induction Year">@context.Year</MudTd>
            <TableDataRightAligned>
                <EditGridButton OnEdit="@(_ => Edit(context))" />
                <DeleteGridButton OnDelete="@(_ => context.Delete())" />
            </TableDataRightAligned>
        </RowTemplate>
    </MudTable>
</DivRowCol12>

