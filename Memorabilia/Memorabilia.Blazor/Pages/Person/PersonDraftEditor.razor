<DivRowFormGroup>
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <Div Class="@DivClass.Column6">
            <FranchiseAutoComplete Disabled="@(EditMode == EditModeType.Update)"
                                   SelectedValue="Model.Franchise"
                                   SelectionChanged="(p) => Model.Franchise = p"
                                   Sports="Model.Sports" />
        </Div>
        <NullableIntField Label="Year"
                          Value="Model.Year"
                          ValueChanged="@((p) => Model.Year = p)" />
        <NullableIntField Label="Round"
                          Value="Model.Round"
                          ValueChanged="@((p) => Model.Round = p)" />
        <NullableIntField Label="Pick"
                          Value="Model.Pick"
                          ValueChanged="OnPickChange" />
        <NullableIntField Label="Overall"
                          Value="Model.Overall"
                          ValueChanged="@((p) => Model.Overall = p)" />
        <AddUpdateFab EditMode="EditMode"
                      OnAdd="Add"
                      OnUpdate="Update" />
    </RowStack>
</DivRowFormGroup>
<DivRowCol12>
    <MudTable Bordered="false"
              Dense="false"
              Hover="true"
              Items="Drafts.ActiveItems().ToList()"
              Striped="true"
              Virtualize="true">
        <NoRecordsContent>
            <NoRecords Text="No records found" />
        </NoRecordsContent>
        <HeaderContent>
            <SortedColumn SortBy="new Func<PersonDraftEditModel, object>(x => x.FranchiseName)" Title="FranchiseName" />
            <SortedColumn SortBy="new Func<PersonDraftEditModel, object>(x => x.Year)" Title="Year" />
            <SortedColumn SortBy="new Func<PersonDraftEditModel, object>(x => x.Round)" Title="Round" />
            <SortedColumn SortBy="new Func<PersonDraftEditModel, object>(x => x.Pick)" Title="Pick" />
            <SortedColumn SortBy="new Func<PersonDraftEditModel, object>(x => x.Overall)" Title="Overall" />
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Franchise">@context.FranchiseName</MudTd>
            <MudTd DataLabel="Year">@context.Year</MudTd>
            <MudTd DataLabel="Round">@context.Round</MudTd>
            <MudTd DataLabel="Pick">@context.Pick</MudTd>
            <MudTd DataLabel="Overall">@context.Overall</MudTd>
            <TableDataRightAligned>
                <EditGridButton OnEdit="@(_ => Edit(context))" />
                <DeleteGridButton OnDelete="@(_ => context.Delete())" />
            </TableDataRightAligned>
        </RowTemplate>
    </MudTable>
</DivRowCol12>


