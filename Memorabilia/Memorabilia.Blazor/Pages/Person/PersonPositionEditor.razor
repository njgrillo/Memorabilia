<DivRowFormGroup>
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <PositionAutoComplete SelectedValue="Model.Position"
                              SelectionChanged="(p) => Model.Position = p"
                              Sports="Sports" />
        <Switch Checked="@(Model.PositionType == PositionType.Primary)"
                CheckedChanged="OnPositionTypeChange"
                Label="Is Primary?" />
        <AddFab OnAdd="Add" />
    </RowStack>
</DivRowFormGroup>
<DivRowCol12>
    <MudTable Bordered="false"
              Dense="false"
              Hover="true"
              Items="Positions.ActiveItems().OrderBy(x => x.PositionTypeName).ThenBy(position => position.PositionName).ToList()"
              Striped="true"
              Virtualize="true">
        <NoRecordsContent>
            <NoRecords Text="No records found" />
        </NoRecordsContent>
        <HeaderContent>
            <SortedColumn SortBy="new Func<PersonPositionEditModel, object>(x => x.PositionName)" Title="Position" />
            <SortedColumn SortBy="new Func<PersonPositionEditModel, object>(x => x.PositionTypeName)" Title="Type" />
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Position">@context.PositionName</MudTd>
            <MudTd DataLabel="Type">@context.PositionTypeName</MudTd>
            <TableDataRightAligned>
                <DeleteGridButton OnDelete="@(_ => Delete(context))" />
            </TableDataRightAligned>
        </RowTemplate>
    </MudTable>
</DivRowCol12>

