<DivRowFormGroup>
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <SportAutoComplete SelectedValue="Model.Sport"
                           SelectionChanged="(p) => Model.Sport = p" />
        <Switch Checked="Model.IsPrimary"
                CheckedChanged="(p) => Model.IsPrimary = p"
                Label="Is Primary?" />
        <AddFab OnAdd="Add" />
    </RowStack>
</DivRowFormGroup>
<DivRowCol12>
    <MudTable Bordered="false"
              Dense="false"
              Hover="true"
              Items="Sports.ActiveItems().OrderBy(sport => sport.IsPrimary).ThenBy(sport => sport.SportName).ToList()"
              Striped="true"
              Virtualize="true">
        <NoRecordsContent>
            <NoRecords Text="No records found" />
        </NoRecordsContent>
        <HeaderContent>
            <SortedColumn SortBy="new Func<PersonSportEditModel, object>(x => x.SportName)" Title="Sport" />
            <SortedColumn SortBy="new Func<PersonSportEditModel, object>(x => x.TypeName)" Title="Type" />
            <MudTh>Sport</MudTh>
            <MudTh>Type</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Sport">@context.SportName</MudTd>
            <MudTd DataLabel="Type">@context.TypeName</MudTd>
            <TableDataRightAligned>
                <DeleteGridButton OnDelete="@(_ => Delete(context))" />
            </TableDataRightAligned>
        </RowTemplate>
    </MudTable>
</DivRowCol12>
