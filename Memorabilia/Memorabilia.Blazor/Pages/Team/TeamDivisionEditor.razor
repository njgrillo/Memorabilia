<DivRowFormGroup>
    <RowStack Class="@DivClass.Column12"
              Style="@Style.MarginBottomPad1">
        <DivisionAutoComplete Disabled="@(EditMode == EditModeType.Update)"
                              SelectedValue="Model.Division"
                              SelectionChanged="(p) => Model.Division = p"
                              SportLeagueLevel="@SportLeagueLevel" />
        <NullableIntField Label="Begin Year"
                          Value="Model.BeginYear"
                          ValueChanged="@((p) => Model.BeginYear = p)" />
        <NullableIntField Label="End Year"
                          Value="Model.EndYear"
                          ValueChanged="@((p) => Model.EndYear = p)" />
        <AddUpdateFab EditMode="EditMode"
                      OnAdd="Add"
                      OnUpdate="Update" />
    </RowStack>
</DivRowFormGroup>
<Div Class="@DivClass.Row">
    <Div Class="@DivClass.Column12">
        <MudTable Bordered="false"
                  Dense="false" 
                  Hover="true"
                  Items="Divisions.ActiveItems().OrderBy(division => division.BeginYear).ToList()"    
                  Striped="true"
                  Virtualize="true">
            <NoRecordsContent>
                <NoRecords Text="No records found" />
            </NoRecordsContent>
            <HeaderContent>
                <SortedColumn SortBy="new Func<TeamDivisionEditModel, object>(x => x.DivisionName)" Title="Division" />
                <SortedColumn SortBy="new Func<TeamDivisionEditModel, object>(x => x.BeginYear)" Title="Begin Year" />
                <SortedColumn SortBy="new Func<TeamDivisionEditModel, object>(x => x.EndYear)" Title="End Year" />
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Division">@context.DivisionName</MudTd>
                <MudTd DataLabel="Begin Year">@context.BeginYear</MudTd>
                <MudTd DataLabel="End Year">@context.EndYear</MudTd>
                <TableDataRightAligned>
                    <EditGridButton OnEdit="@(_ => Edit(context))" />
                    <DeleteGridButton OnDelete="@(_ => context.Delete())" />
                </TableDataRightAligned>
            </RowTemplate>
        </MudTable>
    </Div>
</Div>
