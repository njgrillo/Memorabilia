<MudTable @ref="_table"
          Bordered="false"
          Dense="false"
          Hover="true"
          Items="Model.ForumTopics"
          ServerData="@(new Func<TableState, Task<TableData<ForumTopicModel>>>(OnRead))"
          Striped="true">
    <NoRecordsContent>
        <NoRecords Text="No records found" />
    </NoRecordsContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="category_field" T="ForumTopicModel">Category</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="sport_field" T="ForumTopicModel">Sport</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="subject_field" T="ForumTopicModel">Subject</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="createdby_field" T="ForumTopicModel">Created By</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="createddate_field" T="ForumTopicModel">Created Date</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="lastreplyby_field" T="ForumTopicModel">Last Reply By</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="lastreplydate_field" T="ForumTopicModel">Last Reply Date</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="replies_field" T="ForumTopicModel">Replies</MudTableSortLabel></MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Category">@context.ForumCategoryName</MudTd>
        <MudTd DataLabel="Sport">@context.SportName</MudTd>
        <MudTd DataLabel="Subject">@context.Subject</MudTd>
        <MudTd DataLabel="CreatedBy">@context.CreatedByUsername</MudTd>
        <MudTd DataLabel="CreatedDate">@context.CreatedDate.ToString("MM-dd-yyyy hh:mm:ss tt")</MudTd>
        <MudTd DataLabel="LastReplyBy">@context.LastReplyByUsername</MudTd>
        <MudTd DataLabel="LastReplyDate">@(context.LastReplyByDate.HasValue ? context.LastReplyByDate.Value.ToString("MM-dd-yyyy hh:mm:ss tt") : string.Empty)</MudTd>
        <MudTd DataLabel="Replies">@(context.EntryCount - 1)</MudTd>
        <TableDataRightAligned>
            <Fab Color="MudBlazor.Color.Primary"
                 OnClick="@(_ => NavigationManager.NavigateTo($"{NavigationPath.ForumTopic}/{DataProtectorService.EncryptId(context.Id)}"))"
                 Size="MudBlazor.Size.Small"
                 StartIcon="@Icons.Material.Outlined.Edit"
                 TooltipText="View" />
        </TableDataRightAligned>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
