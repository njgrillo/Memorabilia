<PageView AddRoute="@($"{NavigationPath.MountRushmores}/{Constant.EditModeType.Update.Name}/{DataProtectorService.EncryptId(0)}")"
          AddTitle="@($"{Constant.EditModeType.Add.Name} Mount Rushmore")"
          DisplayPageFooter="false"
          DisplayPageHeader="false"
          NavigationPath="@NavigationPath.Home"
          PageTitle="Collections">
    <DivPad2>
        <MudTable @ref="_table"
                  Bordered="false"
                  Dense="false"
                  Hover="true"
                  Items="Model.MountRushmores"
                  ServerData="@(new Func<TableState, Task<TableData<MountRushmoreModel>>>(OnRead))"
                  Striped="true">
            <NoRecordsContent>
                <NoRecords Text="No records found" />
            </NoRecordsContent>
            <ToolBarContent>
                <ToolbarTitle Text="Mount Rushmores" />
                <MudSpacer />
                <MudTextField Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="mt-0"
                              Placeholder="Search"
                              T="string"
                              ValueChanged="@(search => Filter(search))" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="name_field" T="MountRushmoreModel">Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="description_field" T="MountRushmoreModel">Description</MudTableSortLabel></MudTh>
                <MudTh>Players</MudTh>
                <MudTh><MudTableSortLabel SortLabel="privacytype_field" T="MountRushmoreModel">Privacy Type</MudTableSortLabel></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
                <MudTd DataLabel="Players">
                    @foreach (MountRushmorePersonModel mountRushmorePerson in context.People.OrderBy(person => person.PositionId))
                    {
                        <br>@mountRushmorePerson.Person.ProfileName<br/>
                    }
                </MudTd>
                <MudTd DataLabel="PrivacyType">@context.PrivacyTypeName</MudTd>
                <TableDataRightAligned>
                    <NavigationGridButton NavigationPath="@($"{NavigationPath.MountRushmores}/{Constant.EditModeType.Update.Name}/{DataProtectorService.EncryptId(context.Id)}")" />
                    <DeleteGridButton ConfirmMessage="Delete Mount Rushmore"
                                      OnDelete="@(_ => Delete(context.Id))"
                                      ShowConfirm="true"
                                      TooltipText="Delete Mount Rushmore" />
                </TableDataRightAligned>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DivPad2>
</PageView>

