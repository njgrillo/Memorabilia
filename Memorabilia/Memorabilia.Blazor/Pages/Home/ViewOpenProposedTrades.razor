<MudTable Bordered="false"
          Dense="false"
          Hover="true"
          Items="Items"
          Striped="true">
    <NoRecordsContent>
        <NoRecords Text="No Proposed Trades" />
    </NoRecordsContent>
    <ToolBarContent>
        <ToolbarTitle Text="Proposed Trades" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<OpenProposedTradeModel, object>(x => x.TradePartnerName)" Title="Trade Partner" />
        <SortedColumn SortBy="new Func<OpenProposedTradeModel, object>(x => x.ProposedDate)" Title="Proposed Date" />
        <SortedColumn SortBy="new Func<OpenProposedTradeModel, object>(x => x.ExpirationDate)" Title="Expires Date" />
        <SortedColumn SortBy="new Func<OpenProposedTradeModel, object>(x => x.ProposeTradeStatusTypeName)" Title="Status" />
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="TradePartnerName">@context.TradePartnerName</MudTd>
        <MudTd DataLabel="ProposedDate">@context.ProposedDate.ToString("MM-dd-yyyy")</MudTd>
        <MudTd DataLabel="ExpiresDate">@context.ExpirationDate.ToString("MM-dd-yyyy")</MudTd>
        <MudTd DataLabel="Status">@context.ProposeTradeStatusTypeName</MudTd>
        <TableDataRightAligned>
            <Fab Color="MudBlazor.Color.Secondary"
                 OnClick="@(_ => Review(context.Id))"
                 StartIcon="@Icons.Material.Outlined.Preview"
                 TooltipText="Review" />
        </TableDataRightAligned>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>