<MudTable Bordered="false"
          Dense="false"
          Hover="true"
          Items="Items"
          Striped="true">
    <NoRecordsContent>
        <NoRecords Text="No Accepted Offers" />
    </NoRecordsContent>
    <ToolBarContent>
        <ToolbarTitle Text="Accepted Offers" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<AcceptedOfferModel, object>(x => x.BuyerName)" Title="Buyer" />
        <SortedColumn SortBy="new Func<AcceptedOfferModel, object>(x => x.SellerName)" Title="Seller" />
        <SortedColumn SortBy="new Func<AcceptedOfferModel, object>(x => x.OfferDate)" Title="Offer Date" />
        <SortedColumn SortBy="new Func<AcceptedOfferModel, object>(x => x.Amount)" Title="Amount" />
        <SortedColumn SortBy="new Func<AcceptedOfferModel, object>(x => x.OfferStatusTypeName)" Title="Status" />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Buyer">@context.BuyerName</MudTd>
        <MudTd DataLabel="Seller">@context.SellerName</MudTd>
        <MudTd DataLabel="OfferDate">@context.OfferDate.ToString("MM-dd-yyyy")</MudTd>
        <MudTd DataLabel="Amount">@(context.Amount.ToString("c"))</MudTd>
        <MudTd DataLabel="Status">@context.OfferStatusTypeName</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>