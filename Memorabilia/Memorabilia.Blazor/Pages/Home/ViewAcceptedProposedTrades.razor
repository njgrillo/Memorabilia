<MudTable Bordered="false"
          Dense="false"
          Hover="true"
          Items="Items"
          Striped="true">
    <NoRecordsContent>
        <NoRecords Text="No Accepted Trades" />
    </NoRecordsContent>
    <ToolBarContent>
        <ToolbarTitle Text="Accepted Trades" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<AcceptedProposedTradeModel, object>(x => x.TradePartnerName)" Title="Trade Partner" />
        <SortedColumn SortBy="new Func<AcceptedProposedTradeModel, object>(x => x.ProposedDate)" Title="Proposed Date" />
        <SortedColumn SortBy="new Func<AcceptedProposedTradeModel, object>(x => x.ProposeTradeStatusTypeName)" Title="Status" />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="TradePartnerName">@context.TradePartnerName</MudTd>
        <MudTd DataLabel="ProposedDate">@context.ProposedDate.ToString("MM-dd-yyyy")</MudTd>
        <MudTd DataLabel="Status">@context.ProposeTradeStatusTypeName</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>