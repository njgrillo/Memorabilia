<MudTable Bordered="false"
          Dense="false"
          Hover="true"
          Items="Items"
          Striped="true">
    <NoRecordsContent>
        <NoRecords Text="No Open Offers" />
    </NoRecordsContent>
    <ToolBarContent>
        <ToolbarTitle Text="Offers" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<OpenOfferModel, object>(x => x.BuyerName)" Title="Buyer" />
        <SortedColumn SortBy="new Func<OpenOfferModel, object>(x => x.SellerName)" Title="Seller" />
        <SortedColumn SortBy="new Func<OpenOfferModel, object>(x => x.OfferDate)" Title="Offer Date" />
        <SortedColumn SortBy="new Func<OpenOfferModel, object>(x => x.ExpirationDate)" Title="Expires Date" />
        <SortedColumn SortBy="new Func<OpenOfferModel, object>(x => x.Amount)" Title="Amount" />
        <SortedColumn SortBy="new Func<OpenOfferModel, object>(x => x.OfferStatusTypeName)" Title="Status" />
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Buyer">@context.BuyerName</MudTd>
        <MudTd DataLabel="Seller">@context.SellerName</MudTd>
        <MudTd DataLabel="OfferDate">@context.OfferDate.ToString("MM-dd-yyyy")</MudTd>
        <MudTd DataLabel="ExpiresDate">@context.ExpirationDate.ToString("MM-dd-yyyy")</MudTd>
        <MudTd DataLabel="Amount">@(context.Amount.ToString("c"))</MudTd>
        <MudTd DataLabel="Status">@context.OfferStatusTypeName</MudTd>
        <TableDataRightAligned>
            <Fab Color="MudBlazor.Color.Secondary"
                 OnClick="@(_ => Review(context.Id))"
                 StartIcon="@Icons.Material.Outlined.Preview"
                 TooltipText="Review" />
        </TableDataRightAligned>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>