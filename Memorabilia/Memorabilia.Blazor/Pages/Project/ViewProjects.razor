<PageView AddRoute="@($"{NavigationPath.Projects}/{Constant.EditModeType.Update.Name}/0")"
          AddTitle="Add Project"
          DisplayPageFooter="false"
          DisplayPageHeader="false"
          NavigationPath="@NavigationPath.Home"
          PageTitle="Projects">
    <DivPad2>
        <MudTable Bordered="false"
                  Dense="false"
                  Hover="true"
                  Items="Model.Projects"
                  Striped="true"
                  Virtualize="true">
            <NoRecordsContent>
                <NoRecords Text="No records found" />
            </NoRecordsContent>
            <ToolBarContent>
                <ToolbarTitle Text="Projects" />
            </ToolBarContent>
            <HeaderContent>
                <SortedColumn SortBy="new Func<ProjectModel, object>(x => x.Name)" Title="Name" />
                <SortedColumn SortBy="new Func<ProjectModel, object>(x => x.FormattedStartDate)" Title="Start Date" />
                <SortedColumn SortBy="new Func<ProjectModel, object>(x => x.FormattedEndDate)" Title="End Date" />
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Start Date">@context.FormattedStartDate</MudTd>
                <MudTd DataLabel="End Date">@context.FormattedEndDate</MudTd>
                <TableDataRightAligned>
                    <NavigationGridButton NavigationPath="@($"{NavigationPath.Projects}/{Constant.EditModeType.Update.Name}/{DataProtectorService.EncryptId(context.Id)}")" />
                    <DeleteGridButton ConfirmMessage="Delete Project" 
                                      OnDelete="@(_ => Delete(context.Id))"
                                      ShowConfirm="true" />
                </TableDataRightAligned>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DivPad2>
</PageView>
  