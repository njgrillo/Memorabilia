<DivPad2>
    <LeftRightSection Style="@Style.MarginBottomPad1">
        <Right>
            <AddButton OnClick="AddPrivateSigning" />
        </Right>
    </LeftRightSection>
    <MudTable @ref="_table"
              Bordered="false"
              Dense="false"
              Hover="true"
              Items="Model.PrivateSignings"
              ServerData="@(new Func<TableState, Task<TableData<PromoterPrivateSigningModel>>>(OnRead))"
              Striped="true">
        <NoRecordsContent>
            <NoRecords Text="No Private Signings Found" />
        </NoRecordsContent>
        <ToolBarContent>
            <ToolbarTitle>My Private Signings</ToolbarTitle>
        </ToolBarContent>
        <HeaderContent>
            <MudTh></MudTh>
            <MudTh>Promo Image</MudTh>
            <MudTh></MudTh>
            <MudTh>Signers</MudTh>
            <MudTh>Submission<br/>Deadline</MudTh>
            <MudTh>Start</MudTh>
            <MudTh>End</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>SASE<br />Accepted</MudTh>
            <MudTh>Note</MudTh>
            <MudTh>Created</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <ToggleGridButton Toggled="@(_ => ToggleChildContent(context.Id))"
                                  Visible="@(context.People.Length > 1)" />
            </MudTd>
            <MudTd>
                <GridImage Class="rounded-lg can-click"
                           ImageFileName="@context.PromoterImageFileName"
                           ImageLoaded="StateHasChanged"
                           OnClick="@(_ => OnPromoterImageClick(context.PromoterImageFileName))" />
            </MudTd>
            <MudTd>
                <Condition Evaluation="context.People.Length == 1">
                    <Match>
                        <PersonGridImage Class="rounded-lg can-click"
                                         ImageData="@(ImageService.GetPersonImageData(context.People.First().Person.ImageFileName))"
                                         ImageLoaded="StateHasChanged"
                                         PersonId="context.People.First().Person.Id" />
                    </Match>
                </Condition>                
            </MudTd>
            <MudTd DataLabel="Person">
                @{
                    if (context.IsMultiPersonSigning)
                    {
                        for (int i = 0; i < context.People.Length; i++)
                        {
                            if (i == 5)
                            {
                                @($"{context.People.Length - 5} more") 
                                break;
                            }

                            @context.People[i].Person.DisplayName
                            <br />
                        }
                    }
                    else
                    {
                        @context.Signer
                    }
                 }
            </MudTd>
            <MudTd DataLabel="SubmissionDeadlineDate">@(context.SubmissionDeadlineDate.ToString("MM-dd-yyyy"))</MudTd>
            <MudTd DataLabel="BegingSigningDate">@(context.BeginSigningDate?.ToString("MM-dd-yyyy"))</MudTd>
            <MudTd DataLabel="EndSigningDate">@(context.EndSigningDate?.ToString("MM-dd-yyyy"))</MudTd>
            <MudTd DataLabel="Status">@context.Status</MudTd>
            <MudTd DataLabel="SASEAccepted">
                <Fab Color="MudBlazor.Color.Primary"
                     Size="MudBlazor.Size.Small"
                     StartIcon="@(context.SelfAddressedStampedEnvelopeAccepted ? @Icons.Material.Filled.CheckCircle: Icons.Material.Filled.Dangerous)"
                     TooltipText="@(context.SelfAddressedStampedEnvelopeAccepted ? "Yes": "No")" />
            </MudTd>
            <MudTd DataLabel="Note">@context.Note</MudTd>
            <MudTd DataLabel="CreatedOn">@(context.CreatedDate.ToString("MM-dd-yyyy"))</MudTd>
            <MudTd>
                <EditGridButton OnEdit="@(_ => NavigationManager.NavigateTo($"{NavigationPath.MyPrivateSigningsEdit}/{DataProtectorService.EncryptId(context.Id)}"))"
                                Size="MudBlazor.Size.Small" />
                <Condition Evaluation="@(!context.Published)">
                    <Match>
                        <Condition Evaluation="@(context.People.Length > 0)">
                            <Match>
                                <MudTooltip Text="Publish">
                                    <MudFab Color="@MudBlazor.Color.Success"
                                            OnClick="@(_ => OnPublishClick(context.Id))"
                                            Size="@MudBlazor.Size.Small"
                                            StartIcon="@Icons.Material.Outlined.Publish" />
                                </MudTooltip>
                            </Match>
                        </Condition>                                             
                        <DeleteGridButton ConfirmMessage="Delete Private Signing"
                                          OnDelete="@(_ => Delete(context.Id))"
                                          ShowConfirm="true"
                                          Size="@MudBlazor.Size.Small" />
                    </Match>                    
                </Condition>                
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            <Condition Evaluation="@(context.People.HasAny() && context.People.Length > 1 && context.DisplayDetails)">
                <Match>
                    <tr />
                    <SummarySection>
                        <TableDataCentered>
                            Summary: Total Signers - <strong> @context.People.Length </strong>
                        </TableDataCentered>
                    </SummarySection>
                    <tr />
                    <TableRowPadded>
                        <TableDataSpan>
                            <MudTable Bordered="false"
                                    Dense="false"
                                    Hover="true"
                                    Items="context.People"
                                    Striped="true">
                                <ToolBarContent>
                                    <ToolbarTitle>People</ToolbarTitle>
                                    <MudSpacer />
                                </ToolBarContent>
                                <HeaderContent>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                    <MudTh>Person</MudTh>
                                    <MudTh>Signing Date</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Note</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="privateSigningPerson">
                                    <MudTd>
                                        <GridImage ImageData="@(ImageService.GetUserImageData(privateSigningPerson.PromoterImageFileName, privateSigningPerson.CreatedUserId))"
                                                   ImageLoaded="StateHasChanged"
                                                   Visible="@(!privateSigningPerson.PromoterImageFileName.IsNullOrEmpty())" />
                                    </MudTd>
                                    <MudTd>
                                        <PersonGridImage ImageData="@(ImageService.GetPersonImageData(privateSigningPerson.Person.ImageFileName))"
                                                         ImageLoaded="StateHasChanged"
                                                         PersonId="privateSigningPerson.Person.Id" />
                                    </MudTd>
                                    <MudTd DataLabel="Person">@privateSigningPerson.Person.ProfileName</MudTd>
                                    <MudTd DataLabel="SigningDate">@(privateSigningPerson.SigningDate?.ToString("MM-dd-yyyy"))</MudTd>
                                    <MudTd DataLabel="Status">@privateSigningPerson.Status</MudTd>
                                    <MudTd DataLabel="Note">@privateSigningPerson.Note</MudTd>
                                </RowTemplate>
                                <PagerContent>
                                    <MudTablePager />
                                </PagerContent>
                            </MudTable>
                        </TableDataSpan>
                    </TableRowPadded>
                </Match>
            </Condition>
        </ChildRowContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</DivPad2>

