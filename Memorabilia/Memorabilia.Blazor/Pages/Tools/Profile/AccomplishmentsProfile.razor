@inherits PersonProfile 

<MudTable Bordered="false"
          Dense="false"
          Filter="new Func<AccomplishmentProfileModel, bool>(Filter)"
          Hover="true"
          Items="Accomplishments"
          RowsPerPage="5"
          Striped="true">
    <ToolBarContent>
        <ToolbarTitle Text="Accomplishments" />
        <MudSpacer />
        <ToolbarSearchField SearchText="@_search"
                            SearchTextChanged="@((p) => _search = p)" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<AccomplishmentProfileModel, object>(x => x.AccomplishmentTypeName)" Title="Name" />
        <SortedColumn SortBy="new Func<AccomplishmentProfileModel, object>(x => x.TimeFrame)" Title="Date/Year" />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.AccomplishmentTypeName</MudTd>
        <MudTd DataLabel="Date/Year">@context.TimeFrame</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>