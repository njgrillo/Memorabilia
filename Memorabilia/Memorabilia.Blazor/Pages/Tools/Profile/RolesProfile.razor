@inherits PersonProfile

<TabControl Centered="false"
            Visible="ProfileTypes.Any()">
    <Iterations Context="profileType"
                Items="ProfileTypes">
        <TabPanel BadgeColor="MudBlazor.Color.Success"
                  DisplayBadge="true"
                  Text="@profileType.Name">
            <DivRowCol12>
                <Div>
                    <Condition Evaluation="@(HasSupportedProfile(profileType.Name))">
                        <Match>
                            <DynamicComponent Parameters="Parameters"
                                              Type="@(GetComponent(profileType.Name))" />
                        </Match>
                        <NotMatch>
                            <ComingSoon />
                        </NotMatch>
                    </Condition>                    
                </Div>
            </DivRowCol12>
        </TabPanel>
    </Iterations>
</TabControl>
