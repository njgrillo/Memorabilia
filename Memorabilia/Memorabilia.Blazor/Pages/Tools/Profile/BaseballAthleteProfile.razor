@inherits PersonProfile

<Div Class="@DivClass.Row" 
     Style="overflow-y:auto;max-height:600px;">
    <HiddenControl Visible="Person.HasHighlights(Sport.Baseball)">
        <ExpansionPanel Style="@Style.MarginBottomPad1"
                        Text="Highlights">
            <AccomplishmentSummaryProfile Occupation="Occupation"
                                          Person="Person"
                                          Sport="Sport.Baseball" />
        </ExpansionPanel>
    </HiddenControl>    
    <HiddenControl Visible="Person.Service.HasService()">
        <ExpansionPanel Style="@Style.MarginBottomPad1" 
                        Text="Service">
            <BaseballServiceProfile Person="Person" />
        </ExpansionPanel>
    </HiddenControl> 
    <ExpansionPanel Style="@Style.MarginBottomPad1"
                    Text="Details">
        <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}{Style.MarginTopPad1}")">
            <Link OnClick="ToggleExpand">@_expandToggleText</Link>
        </DivRowCol12>
        <HiddenControl Visible="Person.Accomplishments.Filter(Sport.Baseball, OccupationType).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Accomplishments"
                                IsExpanded="_isExpanded">
                    <AccomplishmentsProfile Occupation="Occupation"
                                            Person="Person"
                                            Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>            
        </HiddenControl>
        <HiddenControl Visible="Person.AllStars.Filter(Sport.Baseball, OccupationType).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="All Star Selections"
                                IsExpanded="_isExpanded">
                    <AllStarProfile Occupation="Occupation"
                                    Person="Person"
                                    Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.Awards.Filter(Sport.Baseball, OccupationType).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Awards"
                                IsExpanded="_isExpanded">
                    <AwardsProfile Occupation="Occupation"
                                   Person="Person"
                                   Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.CareerFranchiseRecords.Filter(Sport.Baseball, OccupationType).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Career Franchise Records"
                                IsExpanded="_isExpanded">
                    <CareerFranchiseRecordsProfile Person="Person"
                                                   Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.CareerRecords.Filter(Sport.Baseball, OccupationType).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Career Records"
                                IsExpanded="_isExpanded">
                    <CareerRecordsProfile Person="Person"
                                          Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.Teams.HasChampionships(Sport.Baseball, OccupationType)">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Championships"
                                IsExpanded="_isExpanded">
                    <ChampionshipProfile Occupation="Occupation"
                                         Person="Person"
                                         Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.Drafts.Filter(Sport.Baseball).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Drafts"
                                IsExpanded="_isExpanded">
                    <DraftsProfile Person="Person"
                                   Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.FranchiseHallOfFames.Filter(Sport.Baseball).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Franchise Hall of Fames"
                                IsExpanded="_isExpanded">
                    <FranchiseHallOfFameProfile Person="Person"
                                                Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.RetiredNumbers.Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Franchise Retired Numbers"
                                IsExpanded="_isExpanded">
                    <FranchiseRetiredNumbersProfile Person="Person" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.InternationalHallOfFames.Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="International Hall of Fames"
                                IsExpanded="_isExpanded">
                    <InternationalHallOfFameProfile Person="Person" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.Leaders.Filter(Sport.Baseball).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Leaders"
                                IsExpanded="_isExpanded">
                    <LeadersProfile Occupation="Occupation"
                                    Person="Person"
                                    Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.Positions.Filter(Sport.Baseball).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Positions"
                                IsExpanded="_isExpanded">
                    <PositionsProfile Person="Person"
                                      Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.SingleSeasonFranchiseRecords.Filter(Sport.Baseball).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Single Season Franchise Records"
                                IsExpanded="_isExpanded">
                    <SingleSeasonFranchiseRecordsProfile Person="Person"
                                                         Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.SingleSeasonRecords.Filter(Sport.Baseball).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Single Season Records"
                                IsExpanded="_isExpanded">
                    <SingleSeasonRecordsProfile Person="Person"
                                                Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.HallOfFames.Filter(Sport.Baseball).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Sport Hall of Fames"
                                IsExpanded="_isExpanded">
                    <SportHallOfFameProfile Person="Person"
                                            Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
        <HiddenControl Visible="Person.Teams.Filter(Sport.Baseball, OccupationType).Any()">
            <DivRowCol12 Style="@($"{Style.MarginBottomPad1}{Style.MarginLeftRightPad1}")">
                <ExpandableLink ExpandText="Teams"
                                IsExpanded="_isExpanded">
                    <TeamsProfile Occupation="Occupation"
                                  Person="Person"
                                  Sport="Sport.Baseball" />
                </ExpandableLink>
            </DivRowCol12>
        </HiddenControl>
    </ExpansionPanel>
</Div>