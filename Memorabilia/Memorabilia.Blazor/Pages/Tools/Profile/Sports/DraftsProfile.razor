@inherits SportProfile

<MudTable Bordered="false"
          Dense="false"
          Filter="new Func<Entity.Draft, bool>(Filter)"
          Hover="true"
          Items="Drafts"
          RowsPerPage="5"
          Striped="true">
    <ToolBarContent>
        <ToolbarTitle><b>Drafts</b></ToolbarTitle>
        <MudSpacer />
        <ToolbarSearchField SearchText="@Search"
                            SearchTextChanged="@((p) => Search = p)" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<Entity.Draft, object>(x => x.Franchise.FullName)" Title="Team" />
        <SortedColumn SortBy="new Func<Entity.Draft, object>(x => x.Year)" Title="Year" />
        <SortedColumn SortBy="new Func<Entity.Draft, object>(x => x.Round)" Title="Round" />
        <SortedColumn SortBy="new Func<Entity.Draft, object>(x => x.Pick)" Title="Pick" />
        <SortedColumn SortBy="new Func<Entity.Draft, object>(x => x.Overall)" Title="Overall" />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Franchise">@context.Franchise.FullName</MudTd>
        <MudTd DataLabel="Year">@context.Year</MudTd>
        <MudTd DataLabel="Round">@context.Round</MudTd>
        <MudTd DataLabel="Pick">@(context.Pick.HasValue ? context.Pick : string.Empty)</MudTd>
        <MudTd DataLabel="Overall">@(context.Overall.HasValue ? context.Overall : string.Empty)</MudTd>
    </RowTemplate>
</MudTable>
