@inherits SportProfile

<MudTable Bordered="false"
          Dense="false" 
          Filter="new Func<LeaderProfileModel, bool>(Filter)"
          Hover="true"
          Items="Leaders"    
          RowsPerPage="5"
          Striped="true">
    <ToolBarContent>
        <ToolbarTitle><b>Leaders</b></ToolbarTitle>
        <MudSpacer />
        <ToolbarSearchField SearchText="@Search"
                            SearchTextChanged="@((p) => Search = p)" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<LeaderProfileModel, object>(x => x.LeaderTypeName)" Title="Team" />
        <SortedColumn SortBy="new Func<LeaderProfileModel, object>(x => x.Year)" Title="Year" />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.LeaderTypeName</MudTd>
        <MudTd DataLabel="Year">@context.Year</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
