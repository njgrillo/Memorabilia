@inherits SportProfile

<MudTable Bordered="false"
          Dense="false"
          Filter="new Func<TeamProfileModel, bool>(Filter)"
          Hover="true"
          Items="Teams"
          RowsPerPage="5"
          Striped="true">
    <ToolBarContent>
        <ToolbarTitle><b>Teams</b></ToolbarTitle>
        <MudSpacer />
        <ToolbarSearchField SearchText="@Search"
                            SearchTextChanged="@((p) => Search = p)" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<TeamProfileModel, object>(x => x.Name)" Title="Team" />
        <SortedColumn SortBy="new Func<TeamProfileModel, object>(x => x.BeginYear)" Title="Begin Year" />
        <SortedColumn SortBy="new Func<TeamProfileModel, object>(x => x.EndYear)" Title="End Year" />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Begin Year">@context.BeginYear</MudTd>
        <MudTd DataLabel="End Year">@context.EndYear</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
