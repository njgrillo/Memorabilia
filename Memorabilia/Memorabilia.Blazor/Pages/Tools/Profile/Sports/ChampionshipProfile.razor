@inherits SportProfile

<MudTable Bordered="false"
          Dense="false"
          Filter="new Func<ChampionshipProfileModel, bool>(Filter)"
          Hover="true"
          Items="Championships"
          RowsPerPage="5"
          Striped="true">
    <ToolBarContent>
        <ToolbarTitle><b>Championships</b></ToolbarTitle>
        <MudSpacer />
        <ToolbarSearchField SearchText="@Search"
                            SearchTextChanged="@((p) => Search = p)" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh></MudTh>
        <SortedColumn SortBy="new Func<ChampionshipProfileModel, object>(x => x.TeamName)" Title="Team" />
        <SortedColumn SortBy="new Func<ChampionshipProfileModel, object>(x => x.Year)" Title="Year" />
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.ChampionshipTypeName</MudTd>
        <MudTd DataLabel="Team">@context.TeamName</MudTd>
        <MudTd DataLabel="Year">@context.Year</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>