@inherits SportProfile

<MudTable Bordered="false"
          Dense="false"
          Filter="new Func<AllStarProfileModel, bool>(Filter)"
          Hover="true"
          Items="AllStars"
          RowsPerPage="5"
          Striped="true">
    <ToolBarContent>
        <ToolbarTitle><b>@($"{HeaderText} Selection(s)")</b></ToolbarTitle>
        <MudSpacer />
        <ToolbarSearchField SearchText="@Search"
                            SearchTextChanged="@((p) => Search = p)" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<AllStarProfileModel, object>(x => x.TeamName)" Title="Team" />
        <SortedColumn SortBy="new Func<AllStarProfileModel, object>(x => x.Year)" Title="Year" />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Team">@context.TeamName</MudTd>
        <MudTd DataLabel="Year">@context.Year</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
