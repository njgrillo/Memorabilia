@inherits PersonProfile

<MudTable Bordered="false"
          Dense="false"
          Filter="new Func<AwardProfileModel, bool>(Filter)"
          Hover="true"
          Items="Awards"
          RowsPerPage="5"
          Striped="true">
    <ToolBarContent>
        <ToolbarTitle><b>Awards</b></ToolbarTitle>
        <MudSpacer />
        <ToolbarSearchField SearchText="@_search"
                            SearchTextChanged="@((p) => _search = p)" />
    </ToolBarContent>
    <HeaderContent>
        <SortedColumn SortBy="new Func<AwardProfileModel, object>(x => x.AwardTypeName)" Title="Name" />
        <SortedColumn SortBy="new Func<AwardProfileModel, object>(x => x.Year)" Title="Year" />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.AwardTypeName</MudTd>
        <MudTd DataLabel="Year">@context.Year</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
