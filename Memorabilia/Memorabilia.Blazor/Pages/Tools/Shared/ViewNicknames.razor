@inherits ViewSportTools<PersonNicknameViewModel>

<DivPad2>
    <ExpansionPanel Text="@($"{Sport?.Name} Nicknames")">
        <DivRowCol12>  
            <MudTable @ref="_table"
                      Bordered="false"
                      Dense="false"
                      Hover="true"
                      Items="Model.Persons.ToList()"
                      ServerData="@(new Func<TableState, Task<TableData<PersonNicknameViewModel>>>(OnRead))"
                      Striped="true"
                      Virtualize="true">
                <NoRecordsContent>
                    <NoRecords Text="No Nicknames Found" />
                </NoRecordsContent>
                <ToolBarContent>
                    <ToolbarTitle Text="Nicknames" />
                    <MudSpacer />
                    <MudTextField Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="mt-0"
                                  Placeholder="Search"
                                  T="string"
                                  ValueChanged="@(search => Filter(search))" />
                </ToolBarContent>
                <HeaderContent>
                    <BlankColumn />
                    <MudTh>
                        <MudTableSortLabel SortLabel="personname_field" T="PersonNicknameViewModel">Person</MudTableSortLabel>
                    </MudTh>
                    <MudTh>Nicknames</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <PersonGridImage ImageData="@(ImageService.GetPersonImageData(context.PersonImageFileName))"
                                         ImageLoaded="StateHasChanged"
                                         PersonId="context.PersonId" />
                    </MudTd>
                    <MudTd DataLabel="Person">
                        @context.PersonName
                    </MudTd>
                    <MudTd DataLabel="Nickname">
                        @{
                            for (int i = 0; i < context.Nicknames.Length; i++)
                            {
                                @context.Nicknames[i]

                                if (i == context.Nicknames.Length - 1)
                                {
                                    continue; 
                                }

                                <br />
                            }
                         }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </DivRowCol12>
    </ExpansionPanel>
</DivPad2>
