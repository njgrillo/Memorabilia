<MudTable @ref="_table"
          Bordered="false"
          Dense="false"
          Hover="true"
          Items="Items.ActiveItems()"
          Striped="true"
          Virtualize="true">
    <NoRecordsContent>
        <NoRecords Text="No records found" />
    </NoRecordsContent>
    <ToolBarContent>
        <ToolbarTitle Text="Items to Receive" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh></MudTh>
        <MudTh></MudTh>
        <SortedColumn SortBy="new Func<ProposeTradeMemorabiliaEditModel, object>(x => x.ItemTypeName)" Title="Item" />
        <SortedColumn SortBy="new Func<ProposeTradeMemorabiliaEditModel, object>(x => x.ConditionName)" Title="Condition" />
        <SortedColumn SortBy="new Func<ProposeTradeMemorabiliaEditModel, object>(x => x.BuyNowPrice)" Title="Buy Now Price" />
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <IconButton Icon="@context.ToggleIcon"
                        OnClick="@(_ => ToggleChildContent(context.MemorabiliaId))" />
        </MudTd>
        <MudTd>
            <GridImage AllowNavigation="false"                       
                       ImageFileName="@context.ImageFileName"
                       ImageLoaded="StateHasChanged"
                       UserId="@context.UserId" />
        </MudTd>
        <MudTd DataLabel="Item">@context.ItemTypeName</MudTd>
        <MudTd DataLabel="Condition">@context.ConditionName</MudTd>
        <MudTd DataLabel="BuyNowPrice">
            @(context.IsForSale && context.BuyNowPrice.HasValue ? context.BuyNowPrice.Value.ToString("c") : "Not for sale")
        </MudTd>
        <TableDataRightAligned>
            <ViewMemorabiliaImagesFab MemorabiliaId="context.MemorabiliaId"
                                      Size="MudBlazor.Size.Large"
                                      UserId="context.UserId" />
            <Fab Color="MudBlazor.Color.Secondary"
                 OnClick="@(_ => context.IsDeleted = true)"
                 StartIcon="@Icons.Material.Outlined.DeleteOutline"
                 TooltipText="Remove"
                 Visible="@(!ReadOnly)" />
        </TableDataRightAligned>
    </RowTemplate>
    <ChildRowContent>
        <HiddenControl Visible="@context.DisplayAutographDetails">
            <tr />
            <SummarySection>
                <TableDataCentered>
                    Summary: Autographs - <strong> @context.AutographsCount </strong>
                </TableDataCentered>
                <HiddenControl Visible="@(!context.Note.IsNullOrEmpty())">
                    <br />
                    <TableDataCentered>
                        Notes:<strong> @context.Note </strong>
                    </TableDataCentered>
                </HiddenControl>
            </SummarySection>
            <tr />
            <TableRowPadded>
                <TableDataSpan>
                    <MudTable Bordered="false"
                              Dense="false"
                              Hover="true"
                              Items="context.Autographs"
                              Striped="true"
                              Virtualize="true">
                        <NoRecordsContent>
                            <NoRecords Text="No records found" />
                        </NoRecordsContent>
                        <ToolBarContent>
                            <ToolbarTitle Text="Autographs" />
                            <MudSpacer />
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh></MudTh>
                            <SortedColumn SortBy="new Func<AutographModel, object>(x => x.PersonName)" Title="Person" />
                            <SortedColumn SortBy="new Func<AutographModel, object>(x => x.ConditionName)" Title="Condition" />
                            <SortedColumn SortBy="new Func<AutographModel, object>(x => x.WritingInstrumentName)" Title="WritingI nstrument" />
                            <SortedColumn SortBy="new Func<AutographModel, object>(x => x.ColorName)" Title="Color" />
                            <MudTh>Authentications</MudTh>
                            <MudTh>Inscriptions</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="autograph">
                            <MudTd>
                                <PersonGridImage ImageData="@(ImageService.GetPersonImageData(autograph.PersonImageName))"
                                                 ImageLoaded="StateHasChanged"
                                                 PersonId="autograph.Person.Id"/>
                            </MudTd>
                            <MudTd DataLabel="Person">@autograph.PersonName</MudTd>
                            <MudTd DataLabel="Condition">@autograph.ConditionName</MudTd>
                            <MudTd DataLabel="Writing Instrument">@autograph.WritingInstrumentName</MudTd>
                            <MudTd DataLabel="Color">@autograph.ColorName</MudTd>
                            <MudTd DataLabel="Authentications"
                                   Style="text-align:center">
                                <Chip Color="MudBlazor.Color.Info"
                                      Size="MudBlazor.Size.Small"
                                      Text="@autograph.AuthenticationText"
                                      TooltipText="@autograph.AuthenticationTooltip" />
                            </MudTd>
                            <MudTd DataLabel="Inscriptions"
                                   Style="text-align:center">
                                <Chip Color="MudBlazor.Color.Info"
                                      Size="MudBlazor.Size.Small"
                                      Text="@autograph.InscriptionText"
                                      TooltipText="@autograph.InscriptionTooltip" />
                            </MudTd>
                            <TableDataRightAligned>
                                <ViewAutographImagesFab AutographId="autograph.Id"
                                                        UserId="autograph.UserId"
                                                        Visible="autograph.Images.Any()" />
                            </TableDataRightAligned>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </TableDataSpan>
            </TableRowPadded>
        </HiddenControl>
    </ChildRowContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
