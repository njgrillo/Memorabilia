<DivPad2>
    <MudTable Bordered="false"
              Dense="false"
              Filter="new Func<DomainModel, bool>(FilterFunc1)"
              Hover="true"
              Items="DomainEntities.OrderBy(item => item.Name)"
              Striped="true"
              Virtualize="true">
        <NoRecordsContent>
            <NoRecords Text="No records found" />
        </NoRecordsContent>
        <ToolBarContent>
            <ToolbarTitle Text="@DomainItemTitle" />
            <MudSpacer />
            <ToolbarSearchField SearchText="@_search"
                                SearchTextChanged="@((p) => _search = p)" />
        </ToolBarContent>
        <HeaderContent>
            <SortedColumn SortBy="new Func<DomainModel, object>(x => x.Name)" Title="Name" />
            <SortedColumn SortBy="new Func<DomainModel, object>(x => x.Abbreviation)" Title="Abbreviation" />
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Abbreviation">@context.Abbreviation</MudTd>
            <TableDataRightAligned>
                <EditGridButton OnEdit="@(_ => NavigationManager.NavigateTo($"{RoutePrefix}/{EditModeType.Update.Name}/{context.Id}"))" />
                <DeleteGridButton ConfirmMessage="@DeleteText" 
                                  OnDelete="@(_ => Delete(context.Id))"
                                  ShowConfirm="true" />
            </TableDataRightAligned>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</DivPad2>
<DivRowCol12Center>
    <AddFab OnAdd="@(_ => NavigationManager.NavigateTo(AddRoute))" 
            TooltipText="@AddText" />
</DivRowCol12Center>
<PageFooter NavigationPath="Admin/EditDomainItems" />